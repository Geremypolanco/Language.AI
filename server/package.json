{
  "name": "language-ai-server",
  "version": "1.0.0",
  "description": "Secure, compliant backend for Language.AI",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/unit/*/*.test.js test/regression/*.test.js",
    "test:integration": "ASSET_LIBRARY_ROOT=test/tmp/academy node --test test/integration/*.test.js",
    "test:all": "node --test",
    "test:coverage": "c8 node --test test/unit/*/*.test.js test/regression/*.test.js",
    "assets:build": "node scripts/build-lesson.js",
    "assets:maintain": "node scripts/run-asset-maintenance.js",
    "verify:ai-architecture": "node scripts/verify-ai-architecture.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "xss": "^1.0.15",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  },
  "c8": {
    "reporter": [
      "text",
      "lcov",
      "json-summary"
    ],
    "exclude": [
      "test/**",
      "scripts/**",
      "eslint.config.js"
    ],
    "check-coverage": true,
    "lines": 80,
    "statements": 80,
    "functions": 55,
    "branches": 75
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
