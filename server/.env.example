# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Auth (used only to derive a stable rate-limit key for authenticated users)
JWT_SECRET=change-me-in-production

# Redis (backing store for distributed rate limiting)
REDIS_URL=redis://localhost:6379

# Rate limiting
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=10

# AI provider (plug in your real provider here)
AI_PROVIDER_API_KEY=replace-with-real-key
AI_PROVIDER_BASE_URL=https://api.your-ai-provider.com

# Cookies
COOKIE_DOMAIN=localhost

# Voice Conversation Engine
VOICE_RATE_LIMIT_WINDOW_MS=60000
VOICE_RATE_LIMIT_MAX=30
VOICE_SESSION_TTL_MS=1800000
VOICE_SUMMARIZE_AFTER_TURNS=16
VOICE_KEEP_RECENT_TURNS=6

# Academic Asset Builder — persisted library location and external providers.
# Every provider below is optional: unconfigured ones simply return no
# candidates and the priority chain moves on to the next source.
ASSET_LIBRARY_ROOT=academy
ASSET_WIKIMEDIA_USER_AGENT=Language.AI-AcademicAssetBuilder/1.0 (contact: you@example.com)
ASSET_OER_BASE_URL=
ASSET_OER_API_KEY=
ASSET_GOOGLE_CSE_API_KEY=
ASSET_GOOGLE_CSE_ID=
ASSET_IMAGE_GEN_API_KEY=
ASSET_IMAGE_GEN_BASE_URL=
ASSET_TTS_API_KEY=
ASSET_TTS_BASE_URL=
