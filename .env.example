# Lingua — standalone app config. Copy to .env in this directory.

# Google Sign-In — a dedicated OAuth client, separate from ARIA's own Google
# OAuth app. Create one at https://console.cloud.google.com/apis/credentials
# ("OAuth client ID" -> "Web application") and register this exact redirect URI:
#   https://language-ai-x90j9w.fly.dev/auth/google/callback   (production, per fly.toml)
#   http://localhost:8100/auth/google/callback                 (local dev)
# See README.md "Google Sign-In setup" for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs session/OAuth-state cookies. Required for sessions to survive a
# restart or work across more than one instance — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
LINGUA_SESSION_SECRET=

# Public origin this instance is served from — must match the domain used in
# the Google redirect URI above. Defaults to http://localhost:$LINGUA_PORT.
# LINGUA_PUBLIC_BASE_URL=https://language-ai-x90j9w.fly.dev

# Durable production storage — a dedicated Supabase Postgres project (never
# ARIA's). Without this, the app falls back to a local SQLite file (fine for
# local dev/tests, not for production — data won't survive a restart).
# See README.md "Supabase setup" for the exact role/grants to create.
# SUPABASE_DB_URL=postgresql://lingua_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Chat + image generation run on Pollinations.ai — free, keyless, no signup,
# nothing to set here. LINGUA_CHAT_MODEL/LINGUA_IMAGE_MODEL below override the
# Pollinations model names if you ever need to.

# Hugging Face token — optional. Powers text-to-speech, speech-to-text, video
# generation, and a chat fallback for when Pollinations' small anonymous
# request budget is temporarily exhausted. Get one at
# https://huggingface.co/settings/tokens (read access is enough).
# Without it: chat/images still work fully via Pollinations; there's just no
# audio/voice/video and no chat fallback.
HF_TOKEN=

# Optional overrides — sensible defaults are baked in.
# LINGUA_CHAT_MODEL=openai
# LINGUA_IMAGE_MODEL=flux
# LINGUA_HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
# LINGUA_STT_MODEL=openai/whisper-large-v3
# LINGUA_TTS_MODEL_PREFIX=facebook/mms-tts
# LINGUA_VIDEO_MODEL=damo-vilab/text-to-video-ms-1.7b
# POLLINATIONS_API_TOKEN=
# LINGUA_DB_PATH=./data/lingua.db
# LINGUA_CACHE_DIR=./data/media_cache
# LINGUA_HOST=0.0.0.0
# LINGUA_PORT=8100

# ── Lingua Pro billing (Stripe) ──────────────────────────────────────────
# One-time $39 (LINGUA_PRO_PRICE_USD) payment via Stripe Checkout for
# unlimited Talk Live conversation. WITHOUT these two, /api/billing/*
# answers 503 and the app stays entirely free — nothing half-wired.
#   1. Stripe Dashboard → Developers → API keys → copy the LIVE secret key
#      (sk_live_...) — or a test key (sk_test_...) to dry-run first.
LINGUA_STRIPE_SECRET_KEY=
#   2. Stripe Dashboard → Developers → Webhooks → Add endpoint:
#        URL: https://language-ai-x90j9w.fly.dev/api/billing/webhook
#        Events: checkout.session.completed
#      → copy the endpoint's Signing secret (whsec_...).
LINGUA_STRIPE_WEBHOOK_SECRET=
#   3. On Fly: fly secrets set LINGUA_STRIPE_SECRET_KEY=... \
#        LINGUA_STRIPE_WEBHOOK_SECRET=... --app language-ai-x90j9w
#      (the GitHub deploy workflow syncs these from repo secrets
#      STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET when set there).
# Optional: use a dashboard-managed Price instead of the inline $39 one:
# LINGUA_STRIPE_PRICE_ID=price_...
# Optional: change the one-time price (USD, integer):
# LINGUA_PRO_PRICE_USD=39
